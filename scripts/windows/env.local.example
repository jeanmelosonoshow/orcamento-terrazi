# Copie para %USERPROFILE%\orcamento-terrazi\env.local
# ou para scripts\windows\env.local.
# A senha Firebird não deve ser escrita aqui; use somente DB_PASSWORD_FILE.

DB_HOST_FB=servidor-firebird
DB_PORT_FB=3050
DB_PATH_FB=caminho-do-banco
DB_USER_FB=usuario-firebird
DB_PASSWORD_FILE=secrets\firebird-password.dpapi

KV_REST_API_URL=url-rest-do-upstash-redis
KV_REST_API_TOKEN=token-rest-do-upstash-redis

FIREBIRD_CACHE_TTL_SECONDS=3600
FIREBIRD_STALE_CACHE_TTL_SECONDS=86400
REDIS_CACHE_TIMEOUT_MS=1500
REDIS_CACHE_PREFIX=orcamento-terrazi
