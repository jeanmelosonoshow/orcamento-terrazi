# Firebird (configurar somente no Gateway)
DB_HOST_FB=host-do-firebird
DB_PORT_FB=3050
DB_PATH_FB=/caminho/banco.fdb
DB_USER_FB=usuario
DB_PASSWORD_FB=senha
DB_CHARSET_FB=NONE
DB_CHARSET_FB_FALLBACK=UTF8

# Na Vercel: conexao HTTPS assinada com o Gateway Windows
FIREBIRD_GATEWAY_URL=https://gateway.jgmelo.company
FIREBIRD_GATEWAY_TOKEN_ID=ssg_token_do_projeto
FIREBIRD_GATEWAY_HMAC_SECRET=segredo_hmac_do_projeto

# Protecao global inicial para aproximadamente 250 usuarios
BI_GATEWAY_CONCURRENCY=8
BI_GATEWAY_QUEUE_LIMIT=100
BI_GATEWAY_QUEUE_TIMEOUT_MS=30000
BI_GATEWAY_LEASE_MS=45000
BI_GATEWAY_LOCK_MS=45000
BI_GATEWAY_CIRCUIT_FAILURES=5
BI_GATEWAY_CIRCUIT_OPEN_MS=15000

# Redis compartilhado (obrigatorio se houver mais de uma replica do Gateway)
UPSTASH_REDIS_REST_URL=https://seu-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=seu-token
BI_GATEWAY_REDIS_PREFIX=terrazi:bi
